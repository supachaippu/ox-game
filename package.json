{
  "name": "ox-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx --test src/lib/game-logic.test.ts",
    "open-next": "npx @cloudflare/next-on-pages && rm -rf build_output && mv .vercel/output/static build_output && rm -rf .vercel",
    "preview": "npm run open-next && wrangler pages dev build_output --d1 DB",
    "deploy": "npm run open-next && wrangler pages deploy build_output"
  },
  "dependencies": {
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.98.0"
  }
}
